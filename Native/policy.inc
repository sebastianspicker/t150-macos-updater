static const TargetProfile *active_profile;
static void select_profile(const TargetProfile *profile) {
    active_profile=profile;result_profile=profile?profile->name:"";
}

static const TargetProfile *find_profile(const char *name) {
    for (unsigned i=0;name && i<PROFILE_SLOTS;++i)
        if (profiles[i].name && !strcmp(profiles[i].name,name)) return profiles+i;
    return NULL;
}

typedef struct {
    char magic[8];
    uint32_t schema, application, target, location;
    uint64_t registry;
    char profile[40];
    char baseline_sha[65], decoded_sha[65], target_sha[65];
    unsigned char reserved[5];
} Manifest;

static void hash_hex(const unsigned char *data, size_t length, char output[65]) {
    unsigned char digest[CC_SHA256_DIGEST_LENGTH];
    CC_SHA256(data,(CC_LONG)length,digest);
    for (unsigned i=0;i<sizeof(digest);++i) snprintf(output+i*2,3,"%02x",digest[i]);
}

static uint32_t little32(const unsigned char *p) {
    return (uint32_t)p[0] | (uint32_t)p[1]<<8 | (uint32_t)p[2]<<16 | (uint32_t)p[3]<<24;
}

static void store_little32(unsigned char *p, uint32_t value) {
    for (unsigned i=0;i<4;++i) p[i]=(unsigned char)(value>>(i*8));
}

static int hash_matches(const unsigned char *data, size_t length, const char *expected) {
    char actual[65];hash_hex(data,length,actual);return expected && !strcmp(actual,expected);
}

static uint32_t application_checksum(const unsigned char *image) {
    uint32_t sum=0;
    for (unsigned i=APP_START;i<FOOTER_OFFSET;++i) sum+=image[i];
    return sum;
}

/* Structural identity of a complete flash image at a stated version. */
static int image_valid(const unsigned char *image, unsigned version) {
    if (!version || little32(image+VERSION_OFFSET) != version ||
        !hash_matches(image,APP_START,boot_sha) || application_checksum(image)!=little32(image+FOOTER_OFFSET)) return 0;
    uint32_t sum=0;
    for (unsigned i=0;i<8;++i) sum+=little32(image+APP_START+i*4);
    uint32_t stack=little32(image+APP_START), reset=little32(image+APP_START+4);
    /* The pinned loader checks non-FFFFFFFF vectors and the app byte sum at
     * 0xfffc. We additionally require aligned nonzero SP, ARM vector checksum,
     * and a Thumb reset within app flash. No unverified SRAM-size claim. */
    return !sum && stack && stack!=UINT32_MAX && !(stack&7) &&
        (reset&1) && (reset&~1u)>=APP_START && (reset&~1u)<IMAGE_SIZE;
}

static unsigned baseline_count(const TargetProfile *profile) {
    unsigned n=0;
    while (n<BASELINE_MAX && profile->same_version_baselines[n]) ++n;
    return n;
}

/* Upgrades accept any structurally valid older application. The same version
 * is accepted only as one of the profile's exact pinned full-flash images. */
static int baseline_valid(const TargetProfile *profile, const unsigned char *image, unsigned application) {
    if (!profile || !image_valid(image,application)) return 0;
    if (application < profile->version) return 1;
    if (application != profile->version) return 0;
    for (unsigned i=0;i<baseline_count(profile);++i)
        if (strcmp(profile->same_version_baselines[i],profile->target_sha) &&
            hash_matches(image,IMAGE_SIZE,profile->same_version_baselines[i])) return 1;
    return 0;
}

static int sha_text(const char *text) {
    if (!text || strlen(text)!=64) return 0;
    for (unsigned i=0;i<64;++i) if (!strchr("0123456789abcdef",text[i])) return 0;
    return 1;
}

/* Marker files store 65 bytes of target_sha, so every compiled hash is checked
 * at runtime too. Patches stay inside the app region, change bytes, and never
 * overlap, so each original-byte assertion reads unpatched official bytes. */
static int patches_valid(const TargetProfile *profile) {
    if (!sha_text(profile->target_sha) || (profile->patch_count && !profile->patches)) return 0;
    for (unsigned i=0;i<baseline_count(profile);++i)
        if (!sha_text(profile->same_version_baselines[i]) || !strcmp(profile->same_version_baselines[i],profile->target_sha)) return 0;
    for (unsigned i=0;i<profile->patch_count;++i) {
        const BytePatch *patch=profile->patches+i;
        if (!patch->length || patch->length>PATCH_MAX || patch->address<APP_START ||
            patch->address>VERSION_OFFSET-patch->length ||
            !memcmp(patch->original,patch->replacement,patch->length)) return 0;
        for (unsigned j=0;j<i;++j) {
            const BytePatch *other=profile->patches+j;
            if (patch->address<other->address+other->length && other->address<patch->address+patch->length) return 0;
        }
    }
    return 1;
}

static int construct_target(const TargetProfile *profile, const unsigned char *baseline, unsigned application,
                            const unsigned char *decoded, unsigned char *target,
                            Run runs[14], unsigned *count) {
    if (!profile || !patches_valid(profile) || !baseline_valid(profile,baseline,application) ||
        !hash_matches(decoded,CONTAINER_SIZE,decoded_sha)) return 1;
    memcpy(target,baseline,IMAGE_SIZE);
    memcpy(target+APP_START,decoded+128,IMAGE_SIZE-APP_START);
    for (unsigned i=0;i<profile->patch_count;++i) {
        const BytePatch *patch=profile->patches+i;
        if (memcmp(target+patch->address,patch->original,patch->length)) return 1;
        memcpy(target+patch->address,patch->replacement,patch->length);
    }
    if (profile->patch_count) store_little32(target+FOOTER_OFFSET,application_checksum(target));
    if (memcmp(target,baseline,APP_START) || !image_valid(target,profile->version) ||
        !hash_matches(target,IMAGE_SIZE,profile->target_sha)) return 1;
    *count=make_runs(baseline,target,runs);
    if (!*count || *count>14) return 1;
    for (unsigned i=0;i<*count;++i)
        if (runs[i].address<APP_START || runs[i].address%4096 || !runs[i].length ||
            runs[i].length%4096 || runs[i].length>IMAGE_SIZE-runs[i].address) return 1;
    return 0;
}

static Manifest make_manifest(const TargetProfile *profile, const unsigned char *baseline, unsigned application,
                              uint64_t registry, unsigned location) {
    Manifest manifest;memset(&manifest,0,sizeof(manifest));memcpy(manifest.magic,"T150S02",8);
    manifest.schema=2;manifest.application=application;manifest.target=profile->version;
    manifest.registry=registry;manifest.location=location;
    snprintf(manifest.profile,sizeof(manifest.profile),"%s",profile->name);
    hash_hex(baseline,IMAGE_SIZE,manifest.baseline_sha);
    strcpy(manifest.decoded_sha,decoded_sha);strcpy(manifest.target_sha,profile->target_sha);
    return manifest;
}

static int load_session(Manifest *manifest, unsigned char *baseline, unsigned char *target) {
    unsigned char *other=malloc(IMAGE_SIZE),*decoded=malloc(CONTAINER_SIZE);
    if (!other || !decoded) { free(other);free(decoded);return 1; }
    int bad=safe_read_at(session_fd,"manifest.bin",manifest,sizeof(*manifest)) ||
        !manifest->registry || !manifest->location ||
        !memchr(manifest->profile,0,sizeof(manifest->profile)) || (select_profile(find_profile(manifest->profile)),!active_profile) ||
        !patches_valid(active_profile) ||
        safe_read_at(session_fd,"backup-a.bin",baseline,IMAGE_SIZE) ||
        safe_read_at(session_fd,"backup-b.bin",other,IMAGE_SIZE) || memcmp(baseline,other,IMAGE_SIZE) ||
        safe_read_at(session_fd,"firmware.tmf",decoded,CONTAINER_SIZE);
    if (!bad) {
        Manifest expected=make_manifest(active_profile,baseline,manifest->application,manifest->registry,manifest->location);
        bad=memcmp(manifest,&expected,sizeof(expected)) ||
            construct_target(active_profile,baseline,manifest->application,decoded,target,result_runs,&result_run_count);
    }
    if (!bad) bad=safe_read_at(session_fd,"target.bin",other,IMAGE_SIZE) || memcmp(other,target,IMAGE_SIZE);
    if (bad) select_profile(NULL);
    free(other);free(decoded);return bad;
}

static int save_manifest(const Manifest *manifest) {
    if (save_at("manifest.bin",manifest,sizeof(*manifest))) return 1;
    char json[4096];
    int size=snprintf(json,sizeof(json),"{\"schema\":2,\"profile\":\"%s\",\"applicationVersion\":%u,\"targetVersion\":%u,\"registryID\":\"%llu\",\"locationID\":%u,\"baselineSHA256\":\"%s\",\"decodedSHA256\":\"%s\",\"targetSHA256\":\"%s\",\"bootloaderSHA256\":\"%s\"}\n",
        manifest->profile,manifest->application,manifest->target,(unsigned long long)manifest->registry,manifest->location,
        manifest->baseline_sha,manifest->decoded_sha,manifest->target_sha,boot_sha);
    return size<0 || (size_t)size>=sizeof(json) || save_at("manifest.json",json,(size_t)size);
}
