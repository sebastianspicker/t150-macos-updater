/* One reviewed byte replacement inside the application region. The original
 * bytes are asserted before writing, so a patch never applies to other code. */
typedef struct {
    unsigned address, length;
    unsigned char original[PATCH_MAX], replacement[PATCH_MAX];
} BytePatch;

/* A target is always the hash-pinned official decoded image plus an optional
 * compiled patch table, and must then equal its own pinned full-image hash.
 * same_version_baselines lists the only full flash images accepted at the
 * target's own version (the other reviewed V35 images: official, fixes, full, sibrec, sibrec_feat,
 * sibrec_raw, sibrec_feat_raw);
 * an empty list permits upgrades only. */
typedef struct {
    const char *name;
    unsigned version;
    const char *target_sha;
    const BytePatch *patches;
    unsigned patch_count;
    const char *same_version_baselines[BASELINE_MAX];
} TargetProfile;

